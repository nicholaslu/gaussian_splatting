// Shared GLSL 4.30 compute source. The OpenGL adapter prepends #version 430
// and exactly one GSPLAT_STAGE_* define before compiling each program.
//
// The stages mirror gsplat_prepare.metal. They use only core OpenGL 4.3
// features: compute shaders, shader-storage buffers and indirect draw. The
// stable radix scatter deliberately avoids subgroup extensions, so GL 4.3 is
// the actual requirement rather than GL 4.6 or a vendor ballot extension.

const uint kRadix = 256u;
const uint kRejected = 0xffffffffu;
const uint kFrustumPlaneFar = 1u;
const float kSHC0 = 0.28209479177387814;
const float kSHC1 = 0.4886025119029199;
const float kSHC2[5] = float[5](
  1.0925484305920792, -1.0925484305920792, 0.31539156525252005,
  -1.0925484305920792, 0.5462742152960396);
const float kSHC3[7] = float[7](
  -0.5900435899266435, 2.890611442640554, -0.4570457994644658,
  0.3731763325901154, -0.4570457994644658, 1.445305721320277,
  -0.5900435899266435);

struct SplatRecord
{
  vec4 position_opacity;
  vec4 scale_pad;
  vec4 quat;
};

struct ViewParameters
{
  vec4 world_rows[4];
  vec4 view_rows[4];
  vec4 frustum_planes[6];
  vec4 local_camera;
  vec4 local_sort_direction;
  float world_scale;
  float focal_y;
  float near_clip;
  float far_clip;
  float ortho_scale;
  float sigma_radius;
  float min_screen_radius;
  float eps2d;
  uint count;
  uint viewport_height;
  uint sh_coefficients;
  uint flags;
};

struct ProjectionParameters
{
  vec4 worldview_rows[4];
  vec4 worldviewproj_rows[4];
  vec4 viewport_size;
  float fovy;
  float eps2d;
  float antialiased;
  float sigma_radius;
};

struct PreparationState
{
  uint visible;
  uint visible_tiles;
  uint gather_groups;
  // Leading instance slots an earlier frame may have filled, and the end of
  // the stale range clear_tail empties this frame. Only a renderer that draws
  // every instance needs them, but they are kept either way.
  uint written;
  uint clear_end;
};

struct ProjectedInstance
{
  vec4 centre_radius;
  vec4 axes;
  vec4 colour;
};

uint orderedFloatKey(float value)
{
  uint bits = floatBitsToUint(value);
  return (bits & 0x80000000u) != 0u ? ~bits : (bits | 0x80000000u);
}

// The culling and depth arithmetic of prepareSplat() in splat_view.hpp, in its
// order and unfused: `precise` stops the compiler contracting a multiply and an
// add into an FMA, as GLSL otherwise may and a baseline x86-64 build of the CPU
// path does not. dot() compiled to an FMA chain put a quarter of the depth keys
// an ulp or more from the CPU's, by thousands of ulp where the depth cancels to
// near zero, which reordered nearby splats. A CPU build that does contract, as
// GCC does for AArch64, can still differ by the last ulp.

// Vector3::dotProduct(), from zero as Ogre sums it.
float dotProduct(vec3 a, vec3 b)
{
  precise float result = 0.0;
  result = result + a.x * b.x;
  result = result + a.y * b.y;
  result = result + a.z * b.z;
  return result;
}

// One row of an affine transform, summed left to right with the translation
// last, as prepareSplat() writes it.
float transformRow(vec4 row, vec3 point)
{
  precise float result = row.x * point.x;
  result = result + row.y * point.y;
  result = result + row.z * point.z;
  result = result + row.w;
  return result;
}

#if defined(GSPLAT_STAGE_COMPACT_SCAN) || defined(GSPLAT_STAGE_RADIX_SCAN_OFFSETS) || \
  defined(GSPLAT_STAGE_RADIX_SCAN_BASES) || defined(GSPLAT_STAGE_RASTER_BIN_COUNT) || \
  defined(GSPLAT_STAGE_RASTER_BIN_SCAN) || defined(GSPLAT_STAGE_RASTER_BIN_EMIT)
// The scans run 256 lanes wide and walk a row 256 entries at a time. Each lane
// looping over a whole row by itself, as these stages once did, cost 4-5 ms of
// a 5-7 ms sort on an RTX 4090: a few hundred threads with long dependent loops
// on a GPU that wants tens of thousands.
const uint kScanWidth = 256u;
shared uint scan_scratch[kScanWidth];
shared uint scan_carry;

// Inclusive prefix sum of `value` across the workgroup (Hillis-Steele). Every
// lane has to call it, the same number of times.
uint workgroupInclusiveScan(uint value)
{
  uint lane = gl_LocalInvocationID.x;
  scan_scratch[lane] = value;
  barrier();
  for (uint offset = 1u; offset < kScanWidth; offset <<= 1u) {
    uint add = lane >= offset ? scan_scratch[lane - offset] : 0u;
    barrier();
    scan_scratch[lane] += add;
    barrier();
  }
  uint result = scan_scratch[lane];
  barrier();
  return result;
}

// Exclusive prefix sums of `count` entries read by `load`, written by `store`,
// carried across chunks in scan_carry, which ends as the row's total.
#define GSPLAT_SCAN_ROW(count, load, store) \
  { \
    if (gl_LocalInvocationID.x == 0u) { \
      scan_carry = 0u; \
    } \
    barrier(); \
    for (uint start = 0u; start < (count); start += kScanWidth) { \
      uint entry = start + gl_LocalInvocationID.x; \
      uint value = entry < (count) ? load(entry) : 0u; \
      uint inclusive = workgroupInclusiveScan(value); \
      if (entry < (count)) { \
        store(entry, scan_carry + inclusive - value); \
      } \
      barrier(); \
      if (gl_LocalInvocationID.x == kScanWidth - 1u) { \
        scan_carry += inclusive; \
      } \
      barrier(); \
    } \
  }
#endif


#if defined(GSPLAT_STAGE_RASTER_BIN_COUNT) || defined(GSPLAT_STAGE_RASTER_BIN_SCAN) || \
  defined(GSPLAT_STAGE_RASTER_BIN_EMIT) || defined(GSPLAT_STAGE_RASTER_CLEAR_RANGES) || \
  defined(GSPLAT_STAGE_RASTER_TILES)
// Tile rasterisation, as in gsplat_prepare.metal: the draw stream GATHER wrote,
// composited front to back by compute, 16x16 pixels per workgroup.
const uint kRasterTile = 16u;
const float kTransmittanceEnd = 0.0001;

struct RasterParameters
{
  uint width;
  uint height;
  uint tiles_x;
  uint tiles_y;
  uint pair_capacity;
  uint pair_tile_capacity;
  uint flip_y;
  float depth_min;
};

// The tiles holding a pixel centre the quad covers, as (x0, y0, x1, y1); see
// tileBounds() in gsplat_prepare.metal.
bool tileBounds(ProjectedInstance q, RasterParameters r, out uvec4 tiles)
{
  tiles = uvec4(0u);
  if (q.centre_radius.w <= 0.0 || q.centre_radius.z > 1.0 || q.centre_radius.z < r.depth_min) {
    return false;
  }
  vec2 size = vec2(r.width, r.height);
  vec2 centre = (q.centre_radius.xy * 0.5 + 0.5) * size;
  if (r.flip_y != 0u) {
    centre.y = size.y - centre.y;
  }
  vec2 extent = (abs(q.axes.xy) + abs(q.axes.zw)) * 0.5 * size;
  vec2 low = ceil(centre - extent - 0.5);
  vec2 high = floor(centre + extent - 0.5);
  if (!all(lessThanEqual(low, high)) || !all(greaterThanEqual(high, vec2(0.0))) ||
    !all(lessThan(low, size)))
  {
    return false;
  }
  uvec2 first = uvec2(max(low, vec2(0.0))) / kRasterTile;
  uvec2 last = uvec2(min(high, size - 1.0)) / kRasterTile;
  tiles = uvec4(first, last);
  return true;
}

uint tileCount(uvec4 tiles)
{
  return (tiles.z - tiles.x + 1u) * (tiles.w - tiles.y + 1u);
}
#endif

#if defined(GSPLAT_STAGE_MAKE_DEPTH_KEYS)
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Splats {SplatRecord splats[];};
layout(std430, binding = 1) writeonly buffer Records {uvec2 records[];};
layout(std430, binding = 2) readonly buffer ViewBlock {ViewParameters p;};

void main()
{
  uint i = gl_GlobalInvocationID.x;
  if (i >= p.count) {
    return;
  }
  SplatRecord splat = splats[i];
  vec3 position = splat.position_opacity.xyz;
  float opacity = splat.position_opacity.w;
  vec3 scale = splat.scale_pad.xyz;
  const float alpha_cutoff = 1.0 / 255.0;
  bool visible = opacity >= alpha_cutoff;
  float visible_radius = visible ?
    min(p.sigma_radius, sqrt(2.0 * log(opacity / alpha_cutoff))) : 0.0;
  float max_sigma = max(scale.x, max(scale.y, scale.z));
  float world_radius = visible_radius * max_sigma * p.world_scale;
  vec3 world_position = vec3(
    transformRow(p.world_rows[0], position), transformRow(p.world_rows[1], position),
    transformRow(p.world_rows[2], position));

  if (visible && (p.flags & 1u) != 0u) {
    for (uint plane = 0u; plane < 6u; ++plane) {
      if (plane == kFrustumPlaneFar && p.far_clip == 0.0) {
        continue;
      }
      precise float distance =
        dotProduct(p.frustum_planes[plane].xyz, world_position) + p.frustum_planes[plane].w;
      if (distance < -world_radius)
      {
        visible = false;
        break;
      }
    }
  }

  if (visible && (p.flags & 1u) != 0u && p.min_screen_radius > 0.0 &&
    p.viewport_height > 0u)
  {
    float screen_radius = 0.0;
    if ((p.flags & 2u) != 0u) {
      float depth = -transformRow(p.view_rows[2], world_position);
      if (depth <= 0.0) {
        visible = false;
      } else {
        screen_radius = p.focal_y * world_radius / max(depth - world_radius, p.near_clip);
      }
    } else {
      screen_radius = p.ortho_scale * world_radius;
    }
    if (visible) {
      float blur_radius = visible_radius * sqrt(max(p.eps2d, 0.0));
      precise float squared = screen_radius * screen_radius + blur_radius * blur_radius;
      screen_radius = sqrt(squared);
      visible = screen_radius >= p.min_screen_radius;
    }
  }

  records[i] = visible ?
    uvec2(orderedFloatKey(dotProduct(position, p.local_sort_direction.xyz)), i) :
    uvec2(0u, kRejected);
}

#elif defined(GSPLAT_STAGE_COMPACT_COUNT)
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Records {uvec2 records[];};
layout(std430, binding = 1) writeonly buffer Counts {uint tile_counts[];};
uniform uint count;
uniform uint tile_count;
uniform uint elements_per_tile;

void main()
{
  uint tile = gl_GlobalInvocationID.x;
  if (tile >= tile_count) {
    return;
  }
  uint begin = tile * elements_per_tile;
  uint end = min(begin + elements_per_tile, count);
  uint survivors = 0u;
  for (uint i = begin; i < end; ++i) {
    survivors += records[i].y != kRejected ? 1u : 0u;
  }
  tile_counts[tile] = survivors;
}

#elif defined(GSPLAT_STAGE_COMPACT_SCAN)
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Counts {uint tile_counts[];};
layout(std430, binding = 1) writeonly buffer Offsets {uint tile_offsets[];};
layout(std430, binding = 2) buffer State {PreparationState state;};
layout(std430, binding = 3) writeonly buffer TileDispatch {
  uint tile_groups_x;
  uint tile_groups_y;
  uint tile_groups_z;
};
layout(std430, binding = 4) writeonly buffer GatherDispatch {
  uint gather_groups_x;
  uint gather_groups_y;
  uint gather_groups_z;
};
layout(std430, binding = 5) buffer DrawArguments {
  uint index_count_out;
  uint instance_count_out;
  uint index_start_out;
  uint base_vertex_out;
  uint base_instance_out;
};
layout(std430, binding = 6) writeonly buffer ClearDispatch {
  uint clear_groups_x;
  uint clear_groups_y;
  uint clear_groups_z;
};
uniform uint tile_count;
uniform uint elements_per_tile;
uniform uint gather_width;
uniform uint index_count;

uint loadTileCount(uint tile)
{
  return tile_counts[tile];
}

void storeTileOffset(uint tile, uint offset)
{
  tile_offsets[tile] = offset;
}

void main()
{
  GSPLAT_SCAN_ROW(tile_count, loadTileCount, storeTileOffset)
  if (gl_LocalInvocationID.x != 0u) {
    return;
  }
  uint visible = scan_carry;
  uint written = state.written;
  state.visible = visible;
  state.visible_tiles = (visible + elements_per_tile - 1u) / elements_per_tile;
  state.gather_groups = (visible + gather_width - 1u) / gather_width;
  // The gather fills [0, visible); what an earlier, larger frame left past
  // that is emptied by clear_tail, so only the shrink costs anything.
  state.clear_end = written;
  state.written = visible;
  uint stale = written > visible ? written - visible : 0u;
  clear_groups_x = max((stale + gather_width - 1u) / gather_width, 1u);
  clear_groups_y = 1u;
  clear_groups_z = 1u;
  // OpenGL rejects a zero-sized indirect dispatch, so launch one guarded
  // group for an empty view just as the Metal backend does.
  tile_groups_x = max(state.visible_tiles, 1u);
  tile_groups_y = 1u;
  tile_groups_z = 1u;
  gather_groups_x = max(state.gather_groups, 1u);
  gather_groups_y = 1u;
  gather_groups_z = 1u;
  index_count_out = index_count;
  instance_count_out = visible;
  index_start_out = 0u;
  base_vertex_out = 0u;
  base_instance_out = 0u;
}

#elif defined(GSPLAT_STAGE_COMPACT_SCATTER)
// Both scatters rank each lane among the 32 of a chunk. Where the driver has
// GL_KHR_shader_subgroup_ballot and the workgroup is one subgroup of 32, that
// takes a few ballots, as on Metal; otherwise each lane counts through shared
// memory, which is core OpenGL 4.3. The host defines GSPLAT_SUBGROUP_BALLOT
// only for a driver that reports the extension and a subgroup size of 32.
layout(local_size_x = 32) in;
layout(std430, binding = 0) readonly buffer InputRecords {uvec2 input_records[];};
layout(std430, binding = 1) writeonly buffer OutputRecords {uvec2 output_records[];};
layout(std430, binding = 2) readonly buffer Offsets {uint tile_offsets[];};
uniform uint count;
uniform uint tile_count;
uniform uint elements_per_tile;
shared uint active_lanes[32];
shared uint cursor;

void main()
{
  uint tile = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationID.x;
  if (tile >= tile_count) {
    return;
  }
  if (lane == 0u) {
    cursor = tile_offsets[tile];
  }
  barrier();
#if defined(GSPLAT_SUBGROUP_BALLOT)
  bool ballot_ranks = gl_SubgroupSize == 32u && gl_NumSubgroups == 1u;
#endif
  uint begin = tile * elements_per_tile;
  uint end = min(begin + elements_per_tile, count);
  uint tile_size = end > begin ? end - begin : 0u;
  for (uint chunk = 0u; chunk < elements_per_tile; chunk += 32u) {
    uint local = chunk + lane;
    uvec2 record = local < tile_size ? input_records[begin + local] : uvec2(0u, kRejected);
    bool live = record.y != kRejected;
    active_lanes[lane] = live ? 1u : 0u;
    barrier();
    uint rank = 0u;
    uint chunk_total = 0u;
#if defined(GSPLAT_SUBGROUP_BALLOT)
    if (ballot_ranks) {
      uint voters = subgroupBallot(live).x;
      rank = bitCount(voters & ((1u << lane) - 1u));
      chunk_total = bitCount(voters);
    } else
#endif
    {
      for (uint other = 0u; other < 32u; ++other) {
        rank += other < lane ? active_lanes[other] : 0u;
        chunk_total += active_lanes[other];
      }
    }
    uint base = cursor;
    if (live) {
      output_records[base + rank] = record;
    }
    barrier();
    if (lane == 0u) {
      cursor += chunk_total;
    }
    barrier();
  }
}

#elif defined(GSPLAT_STAGE_RADIX_HISTOGRAM)
layout(local_size_x = 32) in;
layout(std430, binding = 0) readonly buffer Records {uvec2 records[];};
layout(std430, binding = 1) writeonly buffer Histograms {uint histograms[];};
layout(std430, binding = 2) readonly buffer State {PreparationState state;};
uniform uint tile_count;
uniform uint elements_per_tile;
uniform uint shift;
shared uint local_histogram[256];

void main()
{
  uint tile = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationID.x;
  for (uint digit = lane; digit < kRadix; digit += 32u) {
    local_histogram[digit] = 0u;
  }
  barrier();
  if (tile < state.visible_tiles) {
    uint begin = tile * elements_per_tile;
    uint end = min(begin + elements_per_tile, state.visible);
    for (uint i = begin + lane; i < end; i += 32u) {
      uint digit = (records[i].x >> shift) & 0xffu;
      atomicAdd(local_histogram[digit], 1u);
    }
  }
  barrier();
  if (tile < state.visible_tiles) {
    for (uint digit = lane; digit < kRadix; digit += 32u) {
      histograms[digit * tile_count + tile] = local_histogram[digit];
    }
  }
}

#elif defined(GSPLAT_STAGE_RADIX_SCAN_OFFSETS)
// One workgroup per digit, scanning that digit's count in every tile.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Histograms {uint histograms[];};
layout(std430, binding = 1) writeonly buffer Offsets {uint offsets[];};
layout(std430, binding = 2) writeonly buffer Totals {uint totals[];};
layout(std430, binding = 3) readonly buffer State {PreparationState state;};
uniform uint tile_count;

uint row_base = 0u;

uint loadCount(uint tile)
{
  return histograms[row_base + tile];
}

void storeOffset(uint tile, uint offset)
{
  offsets[row_base + tile] = offset;
}

void main()
{
  uint digit = gl_WorkGroupID.x;
  row_base = digit * tile_count;
  GSPLAT_SCAN_ROW(state.visible_tiles, loadCount, storeOffset)
  if (gl_LocalInvocationID.x == 0u) {
    totals[digit] = scan_carry;
  }
}

#elif defined(GSPLAT_STAGE_RADIX_SCAN_BASES)
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Totals {uint totals[];};
layout(std430, binding = 1) writeonly buffer Bases {uint digit_bases[];};

void main()
{
  uint digit = gl_LocalInvocationID.x;
  uint total = totals[digit];
  digit_bases[digit] = workgroupInclusiveScan(total) - total;
}

#elif defined(GSPLAT_STAGE_RADIX_SCATTER)
layout(local_size_x = 32) in;
layout(std430, binding = 0) readonly buffer InputRecords {uvec2 input_records[];};
layout(std430, binding = 1) writeonly buffer OutputRecords {uvec2 output_records[];};
layout(std430, binding = 2) readonly buffer Offsets {uint offsets[];};
layout(std430, binding = 3) readonly buffer Bases {uint digit_bases[];};
layout(std430, binding = 4) readonly buffer State {PreparationState state;};
uniform uint tile_count;
uniform uint elements_per_tile;
uniform uint shift;
shared uint cursor[256];
shared uint chunk_digit[32];
shared uint chunk_active[32];

void main()
{
  uint tile = gl_WorkGroupID.x;
  uint lane = gl_LocalInvocationID.x;
  for (uint digit = lane; digit < kRadix; digit += 32u) {
    cursor[digit] = tile < state.visible_tiles ?
      digit_bases[digit] + offsets[digit * tile_count + tile] : 0u;
  }
  barrier();
  if (tile >= state.visible_tiles) {
    return;
  }
#if defined(GSPLAT_SUBGROUP_BALLOT)
  bool ballot_ranks = gl_SubgroupSize == 32u && gl_NumSubgroups == 1u;
#endif
  uint begin = tile * elements_per_tile;
  uint end = min(begin + elements_per_tile, state.visible);
  uint tile_size = end > begin ? end - begin : 0u;
  for (uint chunk = 0u; chunk < elements_per_tile; chunk += 32u) {
    uint local = chunk + lane;
    bool live = local < tile_size;
    uvec2 record = live ? input_records[begin + local] : uvec2(0u);
    uint digit = live ? ((record.x >> shift) & 0xffu) : 0u;
    chunk_digit[lane] = digit;
    chunk_active[lane] = live ? 1u : 0u;
    barrier();
    uint rank = 0u;
    uint peer_count = 0u;
#if defined(GSPLAT_SUBGROUP_BALLOT)
    if (ballot_ranks) {
      // The lanes sharing this digit, from one vote on liveness and one on
      // each of the digit's eight bits, as radix_scatter does on Metal.
      uint peers = subgroupBallot(live).x;
      for (uint bit_index = 0u; bit_index < 8u; ++bit_index) {
        bool bit = ((digit >> bit_index) & 1u) != 0u;
        uint votes = subgroupBallot(bit).x;
        peers &= bit ? votes : ~votes;
      }
      rank = bitCount(peers & ((1u << lane) - 1u));
      peer_count = bitCount(peers);
    } else
#endif
    if (live) {
      for (uint other = 0u; other < 32u; ++other) {
        if (chunk_active[other] != 0u && chunk_digit[other] == digit) {
          peer_count += 1u;
          rank += other < lane ? 1u : 0u;
        }
      }
    }
    uint base = live ? cursor[digit] : 0u;
    if (live) {
      output_records[base + rank] = record;
    }
    barrier();
    if (live && rank == 0u) {
      cursor[digit] += peer_count;
    }
    barrier();
  }
}

#elif defined(GSPLAT_STAGE_SHADE_PROJECT)
// Every survivor coloured and projected between compaction and the sort, while
// the compacted list is still in index order, so the splat records and the
// spherical harmonics - by far the scene's largest arrays - are read in the
// order they are stored. After the sort the same reads land in depth order,
// scattered over the whole scene: on an RTX 4090 with the full Garden scene,
// evaluating SH there made the gather 24 times slower. Each result goes to the
// survivor's compacted slot, and the slot replaces the splat index as the
// sort's value, so GATHER only permutes a buffer the size of the visible set.
// The sort is stable and slots follow index order, so the draw order is
// unchanged. Eight storage blocks, the most OpenGL guarantees.
layout(local_size_x = 256) in;
layout(std430, binding = 0) buffer Records {uvec2 records[];};
layout(std430, binding = 1) readonly buffer Splats {SplatRecord splats[];};
layout(std430, binding = 2) readonly buffer Dc {float sh_dc[];};
layout(std430, binding = 3) readonly buffer Rest {float sh_rest[];};
layout(std430, binding = 4) readonly buffer State {PreparationState state;};
layout(std430, binding = 5) writeonly buffer Projected {ProjectedInstance projected[];};
layout(std430, binding = 6) readonly buffer ViewBlock {ViewParameters p;};
layout(std430, binding = 7) readonly buffer ProjectionBlock {ProjectionParameters q;};

vec3 evaluateSH(uint splat, vec3 position)
{
  vec3 colour = kSHC0 * vec3(
    sh_dc[splat * 3u], sh_dc[splat * 3u + 1u], sh_dc[splat * 3u + 2u]) + 0.5;
  vec3 direction = position - p.local_camera.xyz;
  float direction_length = length(direction);
  if (direction_length > 0.0) {
    direction /= direction_length;
  }
  float x = direction.x;
  float y = direction.y;
  float z = direction.z;
  uint coefficient = splat * p.sh_coefficients * 3u;

  if (p.sh_coefficients >= 3u) {
    colour += -kSHC1 * y * vec3(sh_rest[coefficient], sh_rest[coefficient + 1u], sh_rest[coefficient + 2u]);
    colour +=  kSHC1 * z * vec3(sh_rest[coefficient + 3u], sh_rest[coefficient + 4u], sh_rest[coefficient + 5u]);
    colour += -kSHC1 * x * vec3(sh_rest[coefficient + 6u], sh_rest[coefficient + 7u], sh_rest[coefficient + 8u]);
  }
  if (p.sh_coefficients >= 8u) {
    float xx = x * x, yy = y * y, zz = z * z;
    float xy = x * y, yz = y * z, xz = x * z;
    colour += kSHC2[0] * xy * vec3(sh_rest[coefficient + 9u], sh_rest[coefficient + 10u], sh_rest[coefficient + 11u]);
    colour += kSHC2[1] * yz * vec3(sh_rest[coefficient + 12u], sh_rest[coefficient + 13u], sh_rest[coefficient + 14u]);
    colour += kSHC2[2] * (2.0 * zz - xx - yy) * vec3(sh_rest[coefficient + 15u], sh_rest[coefficient + 16u], sh_rest[coefficient + 17u]);
    colour += kSHC2[3] * xz * vec3(sh_rest[coefficient + 18u], sh_rest[coefficient + 19u], sh_rest[coefficient + 20u]);
    colour += kSHC2[4] * (xx - yy) * vec3(sh_rest[coefficient + 21u], sh_rest[coefficient + 22u], sh_rest[coefficient + 23u]);
  }
  if (p.sh_coefficients >= 15u) {
    float xx = x * x, yy = y * y, zz = z * z, xy = x * y;
    colour += kSHC3[0] * y * (3.0 * xx - yy) * vec3(sh_rest[coefficient + 24u], sh_rest[coefficient + 25u], sh_rest[coefficient + 26u]);
    colour += kSHC3[1] * xy * z * vec3(sh_rest[coefficient + 27u], sh_rest[coefficient + 28u], sh_rest[coefficient + 29u]);
    colour += kSHC3[2] * y * (4.0 * zz - xx - yy) * vec3(sh_rest[coefficient + 30u], sh_rest[coefficient + 31u], sh_rest[coefficient + 32u]);
    colour += kSHC3[3] * z * (2.0 * zz - 3.0 * xx - 3.0 * yy) * vec3(sh_rest[coefficient + 33u], sh_rest[coefficient + 34u], sh_rest[coefficient + 35u]);
    colour += kSHC3[4] * x * (4.0 * zz - xx - yy) * vec3(sh_rest[coefficient + 36u], sh_rest[coefficient + 37u], sh_rest[coefficient + 38u]);
    colour += kSHC3[5] * z * (xx - yy) * vec3(sh_rest[coefficient + 39u], sh_rest[coefficient + 40u], sh_rest[coefficient + 41u]);
    colour += kSHC3[6] * x * (xx - 3.0 * yy) * vec3(sh_rest[coefficient + 42u], sh_rest[coefficient + 43u], sh_rest[coefficient + 44u]);
  }
  return max(colour, vec3(0.0));
}

ProjectedInstance projectSplat(SplatRecord splat, vec3 colour)
{
  ProjectedInstance result;
  result.centre_radius = vec4(0.0, 0.0, 2.0, 0.0);
  result.axes = vec4(0.0);
  result.colour = vec4(0.0);
  vec3 position = splat.position_opacity.xyz;
  vec4 homogeneous = vec4(position, 1.0);
  float clip_w = dot(q.worldviewproj_rows[3], homogeneous);
  if (clip_w <= 0.0) {
    return result;
  }

  float x = splat.quat.x, y = splat.quat.y, z = splat.quat.z, w = splat.quat.w;
  mat3 rotation = mat3(
    vec3(1.0 - 2.0 * (y * y + z * z), 2.0 * (x * y + w * z), 2.0 * (x * z - w * y)),
    vec3(2.0 * (x * y - w * z), 1.0 - 2.0 * (x * x + z * z), 2.0 * (y * z + w * x)),
    vec3(2.0 * (x * z + w * y), 2.0 * (y * z - w * x), 1.0 - 2.0 * (x * x + y * y)));
  vec3 scale = splat.scale_pad.xyz;
  mat3 m = mat3(rotation[0] * scale.x, rotation[1] * scale.y, rotation[2] * scale.z);
  mat3 sigma = m * transpose(m);

  float tan_fovy = tan(q.fovy * 0.5);
  float tan_fovx = tan_fovy * q.viewport_size.x / q.viewport_size.y;
  float focal_y = q.viewport_size.y / (2.0 * tan_fovy);
  float focal_x = q.viewport_size.x / (2.0 * tan_fovx);
  vec3 t = vec3(
    dot(q.worldview_rows[0], homogeneous), dot(q.worldview_rows[1], homogeneous),
    dot(q.worldview_rows[2], homogeneous));
  float limx = 1.3 * tan_fovx;
  float limy = 1.3 * tan_fovy;
  t.x = clamp(t.x / t.z, -limx, limx) * t.z;
  t.y = clamp(t.y / t.z, -limy, limy) * t.z;
  vec3 t0 = (focal_x / t.z) * q.worldview_rows[0].xyz +
    (-(focal_x * t.x) / (t.z * t.z)) * q.worldview_rows[2].xyz;
  vec3 t1 = (focal_y / t.z) * q.worldview_rows[1].xyz +
    (-(focal_y * t.y) / (t.z * t.z)) * q.worldview_rows[2].xyz;
  float a = dot(t0, sigma * t0);
  float b = dot(t0, sigma * t1);
  float c = dot(t1, sigma * t1);
  float det_original = a * c - b * b;
  a += q.eps2d;
  c += q.eps2d;
  float compensation = sqrt(max(det_original / (a * c - b * b), 0.0));
  float alpha = splat.position_opacity.w * mix(1.0, compensation, q.antialiased);
  const float alpha_cutoff = 1.0 / 255.0;
  if (alpha < alpha_cutoff) {
    return result;
  }

  float radius = min(q.sigma_radius, sqrt(2.0 * log(alpha / alpha_cutoff)));
  float mid = 0.5 * (a + c);
  float half_difference = 0.5 * (a - c);
  float root = sqrt(half_difference * half_difference + b * b);
  float lambda1 = max(mid + root, 0.01);
  float lambda2 = max(mid - root, 0.01);
  vec2 axis1 = half_difference >= 0.0 ?
    vec2(half_difference + root, b) : vec2(b, root - half_difference);
  float axis_length = length(axis1);
  axis1 = axis_length > 0.0 ? axis1 / axis_length : vec2(1.0, 0.0);
  vec2 axis2 = vec2(-axis1.y, axis1.x);
  vec3 centre = vec3(
    dot(q.worldviewproj_rows[0], homogeneous), dot(q.worldviewproj_rows[1], homogeneous),
    dot(q.worldviewproj_rows[2], homogeneous)) / clip_w;
  result.centre_radius = vec4(centre, radius);
  result.axes = vec4(
    axis1 * (radius * sqrt(lambda1)) * 2.0 / q.viewport_size.xy,
    axis2 * (radius * sqrt(lambda2)) * 2.0 / q.viewport_size.xy);
  result.colour = vec4(colour, alpha);
  return result;
}

void main()
{
  uint slot = gl_GlobalInvocationID.x;
  if (slot >= state.visible) {
    return;
  }
  uint index = records[slot].y;
  SplatRecord splat = splats[index];
  projected[slot] = projectSplat(splat, evaluateSH(index, splat.position_opacity.xyz));
  records[slot].y = slot;
}

#elif defined(GSPLAT_STAGE_GATHER)
// The draw stream in depth order, a permutation of what SHADE_PROJECT wrote.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Sorted {uvec2 sorted_records[];};
layout(std430, binding = 1) readonly buffer Projected {ProjectedInstance projected[];};
layout(std430, binding = 4) readonly buffer State {PreparationState state;};
layout(std430, binding = 5) writeonly buffer Instances {ProjectedInstance instances[];};

void main()
{
  uint output_index = gl_GlobalInvocationID.x;
  if (output_index >= state.visible) {
    return;
  }
  instances[output_index] = projected[sorted_records[output_index].y];
}

#elif defined(GSPLAT_STAGE_CLEAR_TAIL)
// Empties instance slots in [visible, clear_end) for a renderer that draws
// every instance. An empty quad sits outside the clip volume with no extent,
// as projectSplat() leaves a rejected splat.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer State {PreparationState state;};
layout(std430, binding = 1) writeonly buffer Instances {ProjectedInstance instances[];};

void main()
{
  uint slot = state.visible + gl_GlobalInvocationID.x;
  if (slot >= state.clear_end) {
    return;
  }
  instances[slot].centre_radius = vec4(0.0, 0.0, 2.0, 0.0);
  instances[slot].axes = vec4(0.0);
  instances[slot].colour = vec4(0.0);
}

#elif defined(GSPLAT_STAGE_RASTER_BIN_COUNT)
// Tiles per splat, summed over each workgroup of 256 splats in draw order.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Instances {ProjectedInstance instances[];};
layout(std430, binding = 1) readonly buffer State {PreparationState state;};
layout(std430, binding = 2) writeonly buffer BlockSums {uint block_sums[];};
layout(std430, binding = 3) readonly buffer RasterBlock {RasterParameters r;};

void main()
{
  uint i = gl_GlobalInvocationID.x;
  uint count = 0u;
  uvec4 tiles;
  if (i < state.visible && tileBounds(instances[i], r, tiles)) {
    count = tileCount(tiles);
  }
  uint inclusive = workgroupInclusiveScan(count);
  if (gl_LocalInvocationID.x == kScanWidth - 1u) {
    block_sums[gl_WorkGroupID.x] = inclusive;
  }
}

#elif defined(GSPLAT_STAGE_RASTER_BIN_SCAN)
// Where each workgroup's pairs start, the pair count, and the dispatches the
// tile sort and the tile ranges run from.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer BlockSums {uint block_sums[];};
layout(std430, binding = 1) writeonly buffer BlockOffsets {uint block_offsets[];};
layout(std430, binding = 2) readonly buffer State {PreparationState state;};
layout(std430, binding = 3) writeonly buffer RasterState {PreparationState raster_state;};
layout(std430, binding = 4) writeonly buffer SortDispatch {uint sort_dispatch[3];};
layout(std430, binding = 5) writeonly buffer PairDispatch {uint pair_dispatch[3];};
layout(std430, binding = 6) readonly buffer RasterBlock {RasterParameters r;};

uint loadSum(uint block)
{
  return block_sums[block];
}

void storeOffset(uint block, uint offset)
{
  block_offsets[block] = offset;
}

void main()
{
  GSPLAT_SCAN_ROW(state.gather_groups, loadSum, storeOffset)
  if (gl_LocalInvocationID.x != 0u) {
    return;
  }
  // Pairs past the capacity are dropped; `written` keeps the full count.
  uint pairs = min(scan_carry, r.pair_capacity);
  uint pair_tiles = (pairs + 1023u) / 1024u;
  uint pair_groups = (pairs + kScanWidth - 1u) / kScanWidth;
  raster_state.visible = pairs;
  raster_state.visible_tiles = pair_tiles;
  raster_state.gather_groups = pair_groups;
  raster_state.written = scan_carry;
  raster_state.clear_end = 0u;
  sort_dispatch[0] = max(pair_tiles, 1u);
  sort_dispatch[1] = 1u;
  sort_dispatch[2] = 1u;
  pair_dispatch[0] = max(pair_groups, 1u);
  pair_dispatch[1] = 1u;
  pair_dispatch[2] = 1u;
}

#elif defined(GSPLAT_STAGE_RASTER_BIN_EMIT)
// A (tile, draw position) pair per tile each splat's quad touches, in draw
// order, so that a sort stable on the tile keeps each tile's pairs in it.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Instances {ProjectedInstance instances[];};
layout(std430, binding = 1) readonly buffer State {PreparationState state;};
layout(std430, binding = 2) readonly buffer BlockOffsets {uint block_offsets[];};
layout(std430, binding = 3) readonly buffer RasterBlock {RasterParameters r;};
layout(std430, binding = 4) writeonly buffer Pairs {uvec2 pairs[];};

void main()
{
  uint i = gl_GlobalInvocationID.x;
  uint count = 0u;
  uvec4 tiles = uvec4(0u);
  if (i < state.visible && tileBounds(instances[i], r, tiles)) {
    count = tileCount(tiles);
  }
  uint inclusive = workgroupInclusiveScan(count);
  if (count == 0u) {
    return;
  }
  uint cursor = block_offsets[gl_WorkGroupID.x] + inclusive - count;
  for (uint y = tiles.y; y <= tiles.w; ++y) {
    for (uint x = tiles.x; x <= tiles.z; ++x) {
      if (cursor < r.pair_capacity) {
        pairs[cursor] = uvec2(y * r.tiles_x + x, i);
      }
      ++cursor;
    }
  }
}

#elif defined(GSPLAT_STAGE_RASTER_CLEAR_RANGES)
// Each tile's run of pairs, as a start and an end word; see RASTER_TILE_RANGES.
layout(local_size_x = 256) in;
layout(std430, binding = 0) writeonly buffer Ranges {uint ranges[];};
layout(std430, binding = 1) readonly buffer RasterBlock {RasterParameters r;};

void main()
{
  uint word = gl_GlobalInvocationID.x;
  if (word < 2u * r.tiles_x * r.tiles_y) {
    ranges[word] = 0u;
  }
}

#elif defined(GSPLAT_STAGE_RASTER_TILE_RANGES)
// Starts and ends are separate words, since different invocations write them.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Pairs {uvec2 pairs[];};
layout(std430, binding = 1) readonly buffer RasterState {PreparationState raster_state;};
layout(std430, binding = 2) writeonly buffer Ranges {uint ranges[];};

void main()
{
  uint j = gl_GlobalInvocationID.x;
  uint count = raster_state.visible;
  if (j >= count) {
    return;
  }
  uint tile = pairs[j].x;
  if (j == 0u || pairs[j - 1u].x != tile) {
    ranges[2u * tile] = j;
  }
  if (j + 1u == count || pairs[j + 1u].x != tile) {
    ranges[2u * tile + 1u] = j + 1u;
  }
}

#elif defined(GSPLAT_STAGE_RASTER_TILES)
// One workgroup per tile, one invocation per pixel, the tile's pairs staged in
// shared memory 256 at a time and walked front to back; see raster_tiles in
// gsplat_prepare.metal. With subgroup ballots, each 32-wide subgroup holds an
// 8x4 block of the tile and first lists the splats of a batch that reach it.
layout(local_size_x = 256) in;
layout(std430, binding = 0) readonly buffer Pairs {uvec2 pairs[];};
layout(std430, binding = 1) readonly buffer Ranges {uint ranges[];};
layout(std430, binding = 2) readonly buffer Instances {ProjectedInstance instances[];};
layout(std430, binding = 3) readonly buffer RasterBlock {RasterParameters r;};
layout(rgba8, binding = 0) writeonly uniform image2D output_image;

shared vec4 batch_quad[256];    // centre, u
shared vec4 batch_shape[256];   // v, half_radius_squared, opacity
shared vec4 batch_colour[256];
shared ivec4 batch_box[256];    // covered pixels, first and last, inclusive
shared uint finished;
#if defined(GSPLAT_SUBGROUP_BALLOT)
shared uint block_list[8][256];
#endif

void main()
{
  uint lane = gl_LocalInvocationID.x;
  uint group = lane / 32u;
  uint group_lane = lane % 32u;
#if defined(GSPLAT_SUBGROUP_BALLOT)
  bool listing = gl_SubgroupSize == 32u && gl_NumSubgroups == 8u;
  if (listing) {
    group = gl_SubgroupID;
    group_lane = gl_SubgroupInvocationID;
  }
#endif
  uvec2 tile = gl_WorkGroupID.xy;
  uvec2 block = tile * kRasterTile + uvec2((group & 1u) * 8u, (group >> 1u) * 4u);
  uvec2 pixel = block + uvec2(group_lane & 7u, group_lane >> 3u);
  bool inside = pixel.x < r.width && pixel.y < r.height;
  vec2 position = vec2(pixel) + 0.5;
  uint index = tile.y * r.tiles_x + tile.x;
  uint range_start = ranges[2u * index];
  uint range_end = ranges[2u * index + 1u];
  float transmittance = 1.0;
  vec3 colour = vec3(0.0);
  bool done = !inside;
  vec2 size = vec2(r.width, r.height);

  // The pairs are in draw order, back to front; walk them from the end.
  for (uint top = range_end; top > range_start; ) {
    uint batch = min(256u, top - range_start);
    if (lane == 0u) {
      finished = 0u;
    }
    barrier();
    if (lane < batch) {
      ProjectedInstance q = instances[pairs[top - 1u - lane].y];
      vec2 centre = (q.centre_radius.xy * 0.5 + 0.5) * size;
      vec2 a1 = q.axes.xy * 0.5 * size;
      vec2 a2 = q.axes.zw * 0.5 * size;
      if (r.flip_y != 0u) {
        centre.y = size.y - centre.y;
        a1.y = -a1.y;
        a2.y = -a2.y;
      }
      float l1 = dot(a1, a1);
      float l2 = dot(a2, a2);
      batch_quad[lane] = vec4(centre, l1 > 0.0 ? a1 / l1 : vec2(0.0));
      batch_shape[lane] = vec4(l2 > 0.0 ? a2 / l2 : vec2(0.0),
        0.5 * q.centre_radius.w * q.centre_radius.w, l1 > 0.0 && l2 > 0.0 ? q.colour.w : 0.0);
      batch_colour[lane] = vec4(q.colour.xyz, 0.0);
      vec2 extent = abs(a1) + abs(a2);
      batch_box[lane] = ivec4(
        clamp(ceil(centre - extent - 0.5), -1.0, 32767.0),
        clamp(floor(centre + extent - 0.5), -1.0, 32767.0));
    }
    if (done) {
      atomicAdd(finished, 1u);
    }
    memoryBarrierShared();
    barrier();
    if (finished == 256u) {
      break;
    }

#if defined(GSPLAT_SUBGROUP_BALLOT)
    uint listed = batch;
    if (listing) {
      // This subgroup's list, in batch order.
      listed = 0u;
      ivec4 mine = ivec4(ivec2(block), ivec2(block + uvec2(7u, 3u)));
      for (uint first = 0u; first < batch; first += 32u) {
        uint k = first + group_lane;
        bool reaches = false;
        if (k < batch) {
          ivec4 box = batch_box[k];
          reaches = box.x <= mine.z && box.z >= mine.x && box.y <= mine.w && box.w >= mine.y;
        }
        uint votes = subgroupBallot(reaches).x;
        if (reaches) {
          block_list[group][listed + bitCount(votes & ((1u << group_lane) - 1u))] = k;
        }
        listed += bitCount(votes);
      }
      subgroupMemoryBarrierShared();
      subgroupBarrier();
    }
    for (uint n = 0u; n < listed && !done; ++n) {
      uint k = listing ? block_list[group][n] : n;
#else
    for (uint k = 0u; k < batch && !done; ++k) {
#endif
      vec4 quad = batch_quad[k];
      vec4 shape = batch_shape[k];
      vec2 offset = position - quad.xy;
      float cu = dot(offset, quad.zw);
      float cv = dot(offset, shape.xy);
      if (abs(cu) > 1.0 || abs(cv) > 1.0) {
        continue;
      }
      float alpha = min(0.99, shape.w * exp(-shape.z * (cu * cu + cv * cv)));
      if (alpha < 1.0 / 255.0) {
        continue;
      }
      float next = transmittance * (1.0 - alpha);
      if (next < kTransmittanceEnd) {
        done = true;
        break;
      }
      colour += batch_colour[k].xyz * (alpha * transmittance);
      transmittance = next;
    }
    barrier();
    top -= batch;
  }
  if (inside) {
    imageStore(output_image, ivec2(pixel), vec4(colour, 1.0 - transmittance));
  }
}

#else
#error No GSPLAT_STAGE_* was selected
#endif
