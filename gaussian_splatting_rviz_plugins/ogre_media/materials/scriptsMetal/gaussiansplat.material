vertex_program GaussianSplatting/RVizVP metal
{
  source gsplat.metal
  entry_point gsplat_vp

  default_params
  {
    param_named_auto projmatrix worldviewproj_matrix
    param_named_auto viewmatrix worldview_matrix
    param_named_auto vpsize viewport_size
    param_named_auto fovy fov
    param_named eps2d float 0.3
    param_named antialiased float 0.0
    param_named sigma_radius float 3.0
    param_named splat_data_size float4 768 1 0.00130208333 1
  }
}

fragment_program GaussianSplatting/RVizFP metal
{
  source gsplat.metal
  entry_point gsplat_fp
  shader_reflection_pair_hint GaussianSplatting/RVizVP
}

material GaussianSplatting/RViz
{
  technique render
  {
    pass
    {
      lighting off
      cull_hardware none
      cull_software none
      scene_blend one one_minus_src_alpha
      depth_write off

      vertex_program_ref GaussianSplatting/RVizVP {}
      fragment_program_ref GaussianSplatting/RVizFP {}

      // Filled at runtime with the per-splat records; the vertex shader reads
      // texels from it by index. Declared here so the pass has a unit to bind.
      texture_unit
      {
        filtering none
        tex_address_mode clamp
      }
    }
  }

  // RViz draws the scene again under its Pick and Depth schemes, for
  // selection and for the depth behind a click. Its fallback for a material
  // with no technique in those schemes is rviz/flat_vp, which declares
  // POSITION alone -- valid against every vertex format except this one,
  // whose per-instance stream is an index and a colour, with the position
  // living in the data texture. Empty techniques keep the splats out of both
  // passes, which is what already happened when they were drawn offscreen
  // and were simply not visible at the time those passes ran.
  technique pick
  {
    scheme Pick
  }

  technique depth
  {
    scheme Depth
  }
}
