vertex_program GaussianSplatting/CompositeVP glsl
{
  source gsplat_composite.vert
}

fragment_program GaussianSplatting/CompositeFP glsl
{
  source gsplat_composite.frag

  default_params
  {
    param_named splat_texture int 0
  }
}

material GaussianSplatting/Composite
{
  technique
  {
    pass
    {
      lighting off
      cull_hardware none
      cull_software none
      depth_check off
      depth_write off
      scene_blend one one_minus_src_alpha

      vertex_program_ref GaussianSplatting/CompositeVP
      {
      }

      fragment_program_ref GaussianSplatting/CompositeFP
      {
      }

      texture_unit
      {
        tex_address_mode clamp
        filtering linear linear none
      }
    }
  }
}
